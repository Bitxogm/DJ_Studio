# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Backend ───────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:3000

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://beatforge:changeme@localhost:5432/beatforge_db
POSTGRES_DB=beatforge_db
POSTGRES_USER=beatforge
POSTGRES_PASSWORD=changeme

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production_at_least_32_chars_long
JWT_REFRESH_SECRET=change_me_in_production_another_32_chars_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Uploads ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ── Next.js (prefixed NEXT_PUBLIC_ are exposed to the browser) ────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
