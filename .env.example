# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Backend ───────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:3000

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
# Puerto 5434 en el host: el 5432 puede estar ocupado por otro Postgres local.
# Dentro de docker-compose.dev.yml el backend usa postgres:5432 (red interna),
# esto es solo para procesos que corren en el host (prisma migrate/studio, tests).
DATABASE_URL=postgresql://beatforge:changeme@localhost:5434/beatforge_db
POSTGRES_DB=beatforge_db
POSTGRES_USER=beatforge
POSTGRES_PASSWORD=changeme
POSTGRES_HOST_PORT=5434

# ── Auth ──────────────────────────────────────────────────────────────────────
# JWT_SECRET firma el access token. El refresh token NO es un JWT (string aleatorio
# hasheado con SHA-256 en Session.refreshTokenHash), por eso no lleva secreto propio.
JWT_SECRET=change_me_in_production_at_least_32_chars_long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Uploads ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ── Next.js (prefixed NEXT_PUBLIC_ are exposed to the browser) ────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# BACKEND_INTERNAL_URL: usada SOLO por los Route Handlers de Next.js (servidor),
# para hacer de proxy BFF hacia el backend. En docker-compose se sobreescribe a
# http://backend:3001 (nombre de servicio en la red interna); este valor es para
# `pnpm dev` corriendo directamente en el host.
BACKEND_INTERNAL_URL=http://localhost:3001
