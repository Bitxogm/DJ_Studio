# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
.next/
out/
build/

# Environment (cualquier variante real; .env.example es la única excepción)
.env
.env.*
!.env.example

# Certificados y claves privadas
*.pem
*.key
*.crt
*.p12
*.pfx

# Credenciales de cloud / SSH
.aws/
.ssh/

# Volúmenes de datos de Docker (si se montan como bind mount local)
postgres-data/
postgres_data/
pgdata/

# Ficheros de secretos
secrets.json
credentials.json
*.secrets.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Editor (se comparten settings.json y extensions.json, el resto no)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Prisma Client generado (se regenera con `prisma generate`, no se versiona)
apps/backend/src/generated/

# Docker
.docker/

# Testing
coverage/
.nyc_output/

# Uploads
uploads/
